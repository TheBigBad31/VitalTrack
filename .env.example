# ==============================================================================
# VitalTrack — Exemple de Configuration des Variables d'Environnement
# ==============================================================================

# Base de Données
# En production (Neon Postgres Serverless) : postgresql://user:pass@host/dbname?sslmode=require
# En local : non requis (fallback SQLite automatique vers data/vitaltrack.db)
DATABASE_URL=

# Sécurité & Chiffrement (Obligatoires en production Vercel)
# Clé secrète JWT HS256 pour sessions utilisateurs (générer via `openssl rand -hex 32`)
JWT_SECRET=
# Clé maîtresse de chiffrement symétrique Fernet AES-128-CBC (générer via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
DATA_ENCRYPTION_KEY=

# Rate Limiter Distribué — Upstash Redis / Vercel KV (BALI-212 / VTR-103)
# URL de l'API REST Upstash Redis ou Vercel KV (ex: https://xxx.upstash.io ou https://kv.vercel-storage.com)
UPSTASH_REDIS_REST_URL=
# Jeton d'authentification REST Upstash Redis ou Vercel KV
UPSTASH_REDIS_REST_TOKEN=
# (Optionnel Vercel KV aliases) :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Seuils de Rate Limiting (Optionnels, valeurs par défaut indiquées)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=15/minute
RATE_LIMIT_PHOTO_ANALYSIS=15/minute
RATE_LIMIT_WEBHOOK=60/minute

# Clés d'API & OAuth
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
WITHINGS_CLIENT_ID=
WITHINGS_ACCESS_TOKEN=
OURA_PERSONAL_ACCESS_TOKEN=
