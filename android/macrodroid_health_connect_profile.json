{
  "macro_name": "VitalTrack - Passerelle Health Connect Xiaomi",
  "description": "Profil MacroDroid gratuit pour exporter Health Connect (RingConn, Xiaomi, Withings) vers VitalTrack Webhook",
  "version": 2,
  "triggers": [
    {
      "type": "regular_interval",
      "interval_minutes": 15
    },
    {
      "type": "power_disconnected"
    }
  ],
  "actions": [
    {
      "type": "http_request",
      "method": "POST",
      "url": "https://vital-track-one.vercel.app/api/webhooks/health-connect",
      "headers": {
        "Content-Type": "application/json",
        "X-Webhook-Token": "[lv=vitaltrack_token]"
      },
      "body_type": "json",
      "body_content": {
        "source": "health_connect",
        "date": "{year}-{month_digit_2}-{day_digit_2}",
        "weight_kg": "{health_weight}",
        "steps": "{system_steps}",
        "active_calories_kcal": "{health_active_calories}",
        "total_calories_kcal": "{health_total_calories}",
        "distance_meters": "{health_distance}",
        "hydration_ml": "{health_hydration}",
        "skin_temperature_c": "{health_skin_temperature}",
        "resting_hr_bpm": "{health_resting_hr}",
        "hrv_ms": "{health_hrv}",
        "sleep_score": "{health_sleep_score}"
      }
    }
  ],
  "constraints": [
    {
      "type": "network_available",
      "wifi_or_mobile": true
    }
  ]
}
